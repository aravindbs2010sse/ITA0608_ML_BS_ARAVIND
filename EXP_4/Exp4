import numpy as np

# 1. Activation Function and its Derivative
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

def sigmoid_derivative(x):
    return x * (1 - x)

# 2. Sample Dataset (XOR Problem)
# Inputs: 4 samples with 2 attributes each
X = np.array([[0, 0],
              [0, 1],
              [1, 0],
              [1, 1]])

# Target outputs (XOR logic gate)
y = np.array([[0], 
              [1], 
              [1], 
              [0]])

# 3. Network Architecture Setup
input_neurons = 2      # Number of input features
hidden_neurons = 2     # Number of hidden layer neurons
output_neurons = 1     # Number of output neurons
learning_rate = 0.5    # Learning rate (eta)
epochs = 10000         # Training iterations

# Seed random numbers for reproducibility
np.random.seed(42)

# Initialize weights and biases randomly
weights_hidden = np.random.uniform(size=(input_neurons, hidden_neurons))
bias_hidden = np.random.uniform(size=(1, hidden_neurons))

weights_output = np.random.uniform(size=(hidden_neurons, output_neurons))
bias_output = np.random.uniform(size=(1, output_neurons))

# 4. Backpropagation Training Loop
for epoch in range(epochs):
    # --- FORWARD PASS ---
    # Hidden layer activations
    hidden_input = np.dot(X, weights_hidden) + bias_hidden
    hidden_output = sigmoid(hidden_input)
    
    # Output layer activations
    final_input = np.dot(hidden_output, weights_output) + bias_output
    predicted_output = sigmoid(final_input)
    
    # --- BACKPROPAGATION ---
    # Calculate error at output layer
    error_output = y - predicted_output
    delta_output = error_output * sigmoid_derivative(predicted_output)
    
    # Calculate error at hidden layer
    error_hidden = delta_output.dot(weights_output.T)
    delta_hidden = error_hidden * sigmoid_derivative(hidden_output)
    
    # --- UPDATE WEIGHTS AND BIASES ---
    weights_output += hidden_output.T.dot(delta_output) * learning_rate
    bias_output += np.sum(delta_output, axis=0, keepdims=True) * learning_rate
    
    weights_hidden += X.T.dot(delta_hidden) * learning_rate
    bias_hidden += np.sum(delta_hidden, axis=0, keepdims=True) * learning_rate

# 5. Output Results
print("--- BACKPROPAGATION ANN RESULTS ---")
print("Target Output:\n", y)
print("\nPredicted Output after Training:\n", np.round(predicted_output, 4))
print("\nRounded Predictions:\n", np.round(predicted_output))
