import numpy as np
from sklearn.linear_model import LogisticRegression as SklearnLogisticRegression
from sklearn.metrics import accuracy_score

# ==========================================
# 1. LOGISTIC REGRESSION FROM SCRATCH
# ==========================================
class LogisticRegressionScratch:
    def __init__(self, learning_rate=0.1, num_iterations=1000):
        self.lr = learning_rate
        self.num_iterations = num_iterations
        self.weights = None
        self.bias = None

    def _sigmoid(self, z):
        # Sigmoid activation function: 1 / (1 + e^-z)
        return 1 / (1 + np.exp(-z))

    def fit(self, X, y):
        n_samples, n_features = X.shape
        
        # Initialize parameters
        self.weights = np.zeros(n_features)
        self.bias = 0

        # Gradient Descent Optimization
        for _ in range(self.num_iterations):
            # Compute z = X * w + b
            linear_model = np.dot(X, self.weights) + self.bias
            # Predict probabilities
            y_predicted = self._sigmoid(linear_model)

            # Compute gradients
            dw = (1 / n_samples) * np.dot(X.T, (y_predicted - y))
            db = (1 / n_samples) * np.sum(y_predicted - y)

            # Update weights and bias
            self.weights -= self.lr * dw
            self.bias -= self.lr * db

    def predict(self, X):
        linear_model = np.dot(X, self.weights) + self.bias
        y_predicted = self._sigmoid(linear_model)
        # Classify as 1 if probability >= 0.5, else 0
        return np.array([1 if p >= 0.5 else 0 for p in y_predicted])


# ==========================================
# 2. DEMONSTRATION & TESTING
# ==========================================
if __name__ == "__main__":
    # Sample Dataset: [Study Hours, Exam Score] -> Passed (1) or Failed (0)
    X_train = np.array([
        [1.0, 45.0],
        [2.0, 50.0],
        [2.5, 55.0],
        [3.0, 60.0],
        [4.5, 75.0],
        [5.0, 80.0],
        [6.0, 85.0]
    ])
    y_train = np.array([0, 0, 0, 0, 1, 1, 1])

    # Test Samples
    X_test = np.array([
        [2.0, 48.0],  # Should be 0 (Fail)
        [5.5, 82.0]   # Should be 1 (Pass)
    ])

    # --- Test Scratch Implementation ---
    # Standardize input features for fast gradient descent convergence
    mean = np.mean(X_train, axis=0)
    std = np.std(X_train, axis=0)
    X_train_scaled = (X_train - mean) / std
    X_test_scaled = (X_test - mean) / std

    model = LogisticRegressionScratch(learning_rate=0.5, num_iterations=1000)
    model.fit(X_train_scaled, y_train)
    predictions = model.predict(X_test_scaled)

    print("--- LOGISTIC REGRESSION RESULTS ---")
    for sample, pred in zip(X_test, predictions):
        status = "Passed (1)" if pred == 1 else "Failed (0)"
        print(f"Sample {sample}  -->  Prediction: {status}")

    # --- Verification using Scikit-Learn ---
    sk_model = SklearnLogisticRegression()
    sk_model.fit(X_train_scaled, y_train)
    sk_predictions = sk_model.predict(X_test_scaled)

    print("-" * 50)
    print(f"Scikit-Learn Predictions: {sk_predictions}")
